    "test:web": "python3 tests/web_e2e.py",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
