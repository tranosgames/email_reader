{
  "name": "mailforensics-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:web": "npm run wasm && vite --mode web",
